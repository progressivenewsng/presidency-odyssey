// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth models
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User model for authentication and author management (combined with NextAuth)
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?   // For email/password auth
  image         String?
  role          Role      @default(EDITOR)
  posts         Post[]
  accounts      Account[]
  sessions      Session[]
  media         Media[]
  batchJobs     BatchJob[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Category model for news categorization
model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Post model for news articles
model Post {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?
  
  // Images support - first image is cover photo
  images      PostImage[]
  
  // Publishing workflow
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  
  // Flags - using enum array instead of multiple booleans
  flags       PostFlag[]
  
  // Tags for SEO and organization
  tags        Tag[]
  
  // Relationships
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  // Comments
  comments    Comment[]
  
  // Analytics
  views       Int       @default(0)
  
  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// PostImage model for multiple images per article
model PostImage {
  id        String   @id @default(uuid())
  url       String
  altText   String?
  position  Int      @default(0) // For ordering, 0 is cover photo
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Tag model for article keywords
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
}

// Comment model for article comments
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  authorName String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Media model for media library
model Media {
  id          String   @id @default(uuid())
  url         String
  publicId    String   @unique // Cloudinary public ID
  filename    String
  size        Int
  mimeType    String
  alt         String?
  uploadedBy  String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

// BatchJob model for tracking batch upload jobs
model BatchJob {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName          String
  totalRows         Int
  processedRows     Int      @default(0)
  successfulRows    Int      @default(0)
  failedRows        Int      @default(0)
  status            JobStatus @default(PENDING)
  error             String?
  progress          Float    @default(0) // 0-100 percentage
  currentRow        Int?     // Current row being processed
  currentMessage    String?  // Current status message
  fileData          Json?    // Raw file data for processing
  uploadedArticles  Json?    // Array of uploaded article info (results)
  ignoredEntries    Json?    // Array of ignored entry info
  reportUrl         String?  // URL to download the report
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Enums
enum Role {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum PostFlag {
  MAIN_STORY
  EDITORS_PICK
  FEATURED
  TRENDING
  POPULAR
  BREAKING_NEWS
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
